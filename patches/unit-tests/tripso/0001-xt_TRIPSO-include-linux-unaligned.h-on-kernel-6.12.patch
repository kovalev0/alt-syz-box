From 40ec077331fd65fe9fee773bcb1701a1fdda71b7 Mon Sep 17 00:00:00 2001
From: Vasiliy Kovalev <kovalev@altlinux.org>
Date: Wed, 16 Sep 2026 07:58:55 +0000
Subject: [PATCH 1/2] xt_TRIPSO: include <linux/unaligned.h> on kernel 6.12+

Kernel 6.12 moved the unaligned access helpers from <asm/unaligned.h> to
<linux/unaligned.h> and removed the old header, so the module no longer builds
against a >=6.12 tree (fatal error: asm/unaligned.h: No such file or directory).
Probe with __has_include and keep the old path as a fallback so the same source
builds on both pre- and post-6.12 kernels.

Signed-off-by: Vasiliy Kovalev <kovalev@altlinux.org>
---
 xt_TRIPSO.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/xt_TRIPSO.c b/xt_TRIPSO.c
index 0e4a051..63f745f 100644
--- a/xt_TRIPSO.c
+++ b/xt_TRIPSO.c
@@ -11,7 +11,11 @@
  */
 
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+#if __has_include(<linux/unaligned.h>)
+#include <linux/unaligned.h>	/* kernel 6.12+ moved the unaligned helpers here */
+#else
 #include <asm/unaligned.h>
+#endif
 #include <linux/ip.h>
 #include <net/ip.h>
 #include <net/icmp.h>
-- 
