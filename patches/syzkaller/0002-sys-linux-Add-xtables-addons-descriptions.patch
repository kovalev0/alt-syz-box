+ipt_xa_entries_pknock {
+	rule	ipt_xa_entry[ipt_xa_proto_any, xa_pknock_matches, xa_targets_any]
+	p1	ipt_entry_underflow
+	p2	ipt_entry_underflow
+	p3	ipt_entry_underflow
+} [packed, align[PTR_SIZE]]
+
+# ==================== ENTRY TEMPLATE ====================
+
+type ipt_xa_entry[PROTO, MATCHES, TARGETS] {
+	matches	ipt_xa_entry_matches[PROTO, MATCHES]
+	target	TARGETS
+} [packed, align[PTR_SIZE]]
+
+type ipt_xa_entry_matches[PROTO, MATCHES] {
+	ip		ipt_xa_ip[PROTO]
+	nfcache		const[0, int32]
+	target_offset	len[parent, int16]
+	next_offset	len[ipt_xa_entry, int16]
+	comefrom	const[0, int32]
+	counters	xt_counters
+	matches		array[MATCHES, 0:2]
+} [align[PTR_SIZE]]
+
+# Wildcard ipt_ip: all selectors zeroed, only ipt_ip.proto is used.
+#
+# This is what decides whether the rule ever fires on a packet.
+# ip_packet_match() requires
+#	(saddr & smsk) == src, (daddr & dmsk) == dst
+#	ifname_compare_aligned(indev, iniface, iniface_mask) == 0
+# and syzkaller's ipv4_addr / ipv4_addr_mask / devname pick random values out
+# of their pools, so a randomly generated selector matches essentially no
+# packet: every extension without a .checkentry stayed at exactly 0% while
+# every extension with one got coverage. Zeroing the selectors is what
+# "iptables -I INPUT -j TARGET" produces and makes the rule match everything
+# that reaches its hook.
+#
+# invflags stays 0 as well: IPT_INV_SRCIP/DSTIP/VIA_* would invert these
+# comparisons and put us back to never matching, and IPT_INV_PROTO would break
+# the .proto-restricted extensions. IPT_F_FRAG would demand fragments.
+type ipt_xa_ip[PROTO] {
+	src		const[0, int32be]
+	dst		const[0, int32be]
+	smsk		const[0, int32be]
+	dmsk		const[0, int32be]
+	iniface		array[const[0, int8], IFNAMSIZ]
+	outiface	array[const[0, int8], IFNAMSIZ]
+	iniface_mask	array[const[0, int8], IFNAMSIZ]
+	outiface_mask	array[const[0, int8], IFNAMSIZ]
+	proto		PROTO
+	flags		const[0, int8]
+	invflags	const[0, int8]
+}
+
+type ipt_xa_proto_any	flags[ipv4_types, int16]
+type ipt_xa_proto_tcp	const[IPPROTO_TCP, int16]
+type ipt_xa_proto_udp	const[IPPROTO_UDP, int16]
+
+
+# ==================== SHARED NAME POOL ====================
+# Fixed name pool for the extensions that create a named procfs entry. The same
+# pool is used by dev_xt_addons.txt, so the procfs write() descriptions target
+# exactly the names the fuzzer registers here. No empty string: these feed
+# fixed-length string[] buffers and "" would collapse the buffer to length 1.
+xt_addon_names = "syz0", "syz1", "syz2"
+
+# ==================== MATCH UNIONS ====================
+# Everything here registers without .table, .hooks or .proto, so it is legal in
+# any of the skeletons above.
+xa_matches [
+	condition	xt_entry_match_t["condition", xt_condition_mtinfo, 1]
+	quota2		xt_entry_match_t["quota2", xt_quota_mtinfo2, 3]
+	fuzzy		xt_entry_match_t["fuzzy", xt_fuzzy_mtinfo, 1]
+	iface		xt_entry_match_t["iface", xt_iface_mtinfo, 0]
+	length2		xt_entry_match_t["length2", xt_length_mtinfo2, 2]
+	psd		xt_entry_match_t["psd", xt_psd_info, 1]
+	geoip		xt_entry_match_t["geoip", xt_geoip_match_info, 2]
+	asn		xt_entry_match_t["asn", xt_asn_match_info, 1]
+	ipv4options	xt_entry_match_t["ipv4options", xt_ipv4options_mtinfo1, 1]
+# so (ipt-so) rides along here as well as in its own skeletons in
+# netfilter_ipt_so.txt. so_mt_reg declares no .table/.hooks/.proto, so it is
+# legal in every skeleton above, and these seven syscalls already have corpus
+# entries -- reaching so_mt() only through the three IPT_SO_SET_REPLACE_SO_*
+# variants made it strictly harder to hit than the nine matches next to it,
+# which is why xt_so.c stayed at 0% while xt_ipv4options.c (also without a
+# .checkentry) reached 34%.
+	so		xt_entry_match_t["so", so_info, 0]
+] [varlen]
+
+# lscan registers with .proto = IPPROTO_TCP.
+# pknock lives in its own skeleton rather than in xa_matches.
+# xt_pknock_mt_init() can fail -- request_module() returns -ENOSYS on a kernel
+# without loadable modules, and crypto_alloc_shash("hmac(sha256)") needs
+# CRYPTO_MANAGER to instantiate the template -- and an unregistered match makes
+# xt_find_match() fail, which takes down the whole IPT_SO_SET_REPLACE blob. At
+# 0..2 matches per rule out of a pool of ten that poisoned roughly a fifth of
+# every table the fuzzer built. Keeping it separate confines the damage to one
+# syscall.
+xa_pknock_matches [
+	pknock	xt_entry_match_t["pknock", xt_pknock_mtinfo, 1]
+] [varlen]
+
+xa_matches_tcp [
+	common	xa_matches
+	lscan	xt_entry_match_t["lscan", xt_lscan_mtinfo, 0]
+] [varlen]
+
+# The dhcpmac *match* (as opposed to the DHCPMAC target) registers with
+# .proto = IPPROTO_UDP and no .table.
+xa_matches_udp [
+	common	xa_matches
+	dhcpmac	xt_entry_match_t["dhcpmac", dhcpmac_info, 0]
+] [varlen]
+
+# ==================== TARGET UNIONS ====================
+# LOGMARK registers with neither .table nor .hooks nor .proto.
+xa_targets_any [
+	LOGMARK	xt_target_t["LOGMARK", xt_logmark_tginfo, 0]
+] [varlen]
+
+xa_filter_targets [
+	common	xa_targets_any
+	CHAOS	xt_target_t["CHAOS", xt_chaos_tginfo, 0]
+] [varlen]
+
+# CHAOS .hooks is IN|FWD|OUT, which is a superset of this skeleton's IN|FWD.
+xa_filter_tcp_targets [
+	common	xa_targets_any
+	CHAOS	xt_target_t["CHAOS", xt_chaos_tginfo, 0]
+	TARPIT	xt_target_t["TARPIT", xt_tarpit_tginfo, 0]
+	DELUDE	xt_target_t["DELUDE", void, 0]
+] [varlen]
+
+xa_filter_udp_targets [
+	common	xa_targets_any
+	ECHO	xt_target_t["ECHO", void, 0]
+] [varlen]
+
+xa_mangle_targets [
+	common	xa_targets_any
+	IPMARK	xt_target_t["IPMARK", xt_ipmark_tginfo, 1]
+	PROTO	xt_target_t["PROTO", xt_PROTO_info, 0]
+] [varlen]
+
+xa_mangle_udp_targets [
+	common	xa_mangle_targets
+	DHCPMAC	xt_target_t["DHCPMAC", dhcpmac_info, 0]
+] [varlen]
+
+# ACCOUNT stays disabled: ipt_acc_checkentry() -> ipt_acc_table_insert()
+# allocates under spin_lock_bh, and every ACCOUNT sockopt takes an
+# uninitialised-key semaphore. Both have C repros.
+xa_nat_targets [
+	common	xa_targets_any
+	DNETMAP	xt_target_t["DNETMAP", xt_DNETMAP_tginfo, 0]
+] [varlen]
+
+# ==================== condition (match, rev 1) ====================
+# name goes through xt_check_proc_name(): no '.', '..', '/', no control chars,
+# NUL-terminated. condvar is kernel-internal; keep it zero.
+# Layout: char name[31]; __u8 invert; void *condvar __attribute__((aligned(8)));
+# -> sizeof == 40.
+xt_condition_mtinfo {
+	name	string[xt_addon_names, CONDITION_NAME_LEN]
+	invert	bool8
+	condvar	const[0, intptr]
+}
+
+# ==================== quota2 (match, rev 3) ====================
+# char name[15]; u8 flags; aligned_u64 quota; struct * master; -> sizeof == 32.
+# name is left empty, which takes q2_get_counter()'s anonymous path. With a
+# non-empty name it kmalloc(GFP_KERNEL)s while holding counter_list_lock ->
+# "BUG: sleeping function called from invalid context in q2_new_counter" on
+# every new (netns, name) pair. Already reproduced. Restore
+# string[xt_addon_names, 15] to hunt it again and to reach
+# /proc/net/xt_quota/<name>.
+xt_quota_mtinfo2 {
+	name	array[const[0, int8], 15]
+	flags	flags[xt_quota2_flags, int8]
+	quota	int64
+	master	const[0, intptr]
+}
+
+xt_quota2_flags = XT_QUOTA_INVERT, XT_QUOTA_GROW, XT_QUOTA_PACKET, XT_QUOTA_NO_CHANGE
+
+# ==================== fuzzy (match, rev 1) ====================
+# fuzzy_mt_check enforces FUZZY_MIN_RATE <= minimum_rate,
+# maximum_rate <= FUZZY_MAX_RATE, minimum_rate < maximum_rate. Bias toward valid
+# so the packet path (fuzzy_mt) is reached, but leave slack for the -EDOM path.
+xt_fuzzy_mtinfo {
+	minimum_rate	int32[3:10000000]
+	maximum_rate	int32[3:10000000]
+	packets_total	int32
+	bytes_total	int32
+	previous_time	int32
+	present_time	int32
+	mean_rate	int32
+	acceptance_rate	int8
+}
+
+# ==================== iface (match, rev 0) ====================
+xt_iface_mtinfo {
+	ifname		devname
+	flags		flags[xt_iface_flags, int16]
+	invflags	flags[xt_iface_flags, int16]
+}
+
+xt_iface_flags = XT_IFACE_UP, XT_IFACE_BROADCAST, XT_IFACE_LOOPBACK, XT_IFACE_POINTOPOINT, XT_IFACE_RUNNING, XT_IFACE_NOARP, XT_IFACE_PROMISC, XT_IFACE_MULTICAST, XT_IFACE_DYNAMIC, XT_IFACE_LOWER_UP, XT_IFACE_DORMANT, XT_IFACE_DEV_IN, XT_IFACE_DEV_OUT
+
+# ==================== length2 (match, rev 2) ====================
+xt_length_mtinfo2 {
+	min	int32
+	max	int32
+	flags	flags[xt_length2_flags, int16]
+}
+
+xt_length2_flags = XT_LENGTH_INVERT, XT_LENGTH_LAYER3, XT_LENGTH_LAYER4, XT_LENGTH_LAYER5, XT_LENGTH_LAYER7
+
+# ==================== psd (match, rev 1) ====================
+# psd_mt_check: weight_threshold != 0, (lo|hi) != 0, all <= PSD_MAX_RATE (10000).
+xt_psd_info {
+	weight_threshold	int32[1:10000]
+	delay_threshold		int32[0:10000]
+	lo_ports_weight		int16[0:10000]
+	hi_ports_weight		int16[0:10000]
+}
+
+# ==================== geoip (match, rev 2) ====================
+# count is clamped to the real array length. The out-of-bounds write is already
+# found and reproduced; leaving count at the full __u8 range panics the VM on
+# nearly every geoip rule (panic_on_warn=1). Widen to int8 to hunt it again.
+# sizeof == 312.
+xt_geoip_match_info {
+	flags	flags[xt_geoip_flags, int8]
+	count	int8[0:XT_GEOIP_MAX]
+	cc	array[int16, XT_GEOIP_MAX]
+	mem	array[geoip_country_group, XT_GEOIP_MAX]
+}
+
+xt_geoip_flags = XT_GEOIP_SRC, XT_GEOIP_DST, XT_GEOIP_INV
+
+# union geoip_country_group holds a user pointer to a geoip_country_user, which
+# geoip_add_node copies with copy_from_user. Point it at a real, well-formed
+# table so checkentry proceeds past the copy and exercises geoip_add_node fully.
+geoip_country_group {
+	user	ptr64[in, geoip_country_user]
+}
+
+geoip_country_user {
+	subnets	ptr64[in, array[geoip_subnet4, 0:8]]
+	count	int32[0:8]
+	cc	int16
+}
+
+geoip_subnet4 {
+	begin	int32
+	end	int32
+}
+
+# ==================== asn (match, rev 1) ====================
+# Same out-of-bounds shape as geoip but XT_ASN_MAX = 15; clamped for the same
+# reason. sizeof == 184.
+xt_asn_match_info {
+	asn	array[int32, XT_ASN_MAX]
+	flags	flags[xt_asn_flags, int8]
+	count	int8[0:XT_ASN_MAX]
+	mem	array[asn_number_group, XT_ASN_MAX]
+}
+
+xt_asn_flags = XT_ASN_SRC, XT_ASN_DST, XT_ASN_INV
+
+asn_number_group {
+	user	ptr64[in, asn_number_user]
+}
+
+asn_number_user {
+	subnets	ptr64[in, array[geoip_subnet4, 0:8]]
+	count	int32[0:8]
+	asn	int32
+}
+
+# ==================== ipv4options (match, rev 1) ====================
+xt_ipv4options_mtinfo1 {
+	map	int32
+	invert	int32
+	flags	flags[xt_v4opts_flags, int8]
+}
+
+xt_v4opts_flags = XT_V4OPTS_ALL, XT_V4OPTS_ANY
+
+# ==================== lscan (match, rev 0, .proto = TCP) ====================
+xt_lscan_mtinfo {
+	match_fl1	int8
+	match_fl2	int8
+	match_fl3	int8
+	match_fl4	int8
+}
