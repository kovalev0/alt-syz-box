+# predictable for dev_xt_addons.txt; all pool entries are 4 characters long, so
+# rule_name_len is a constant. pknock_mt_check() rejects rule_name_len == 0 and
+# requires XT_PKNOCK_NAME in option. sizeof == 148.
+xt_pknock_mtinfo {
+	rule_name	string[xt_addon_names, 32]
+	rule_name_len	const[4, int32]
+	open_secret	string[xt_addon_secrets, 32]
+	open_secret_len	const[4, int32]
+	close_secret	string[xt_addon_secrets, 32]
+	close_secret_len	const[4, int32]
+	option		flags[xt_pknock_opts, int8]
+	ports_count	int8[0:15]
+	port		array[sock_port, XT_PKNOCK_MAX_PORTS]
+	max_time	int32
+	autoclose_time	int32
+}
+
+xt_addon_secrets = "sec0", "sec1"
+xt_pknock_opts = XT_PKNOCK_KNOCKPORT, XT_PKNOCK_TIME, XT_PKNOCK_NAME, XT_PKNOCK_STRICT, XT_PKNOCK_CHECKIP, XT_PKNOCK_OPENSECRET, XT_PKNOCK_CLOSESECRET, XT_PKNOCK_AUTOCLOSE
+
+# ==================== TARPIT / CHAOS (targets) ====================
+# variant is an enum, not a bitmask: 0 TARPIT, 1 HONEYPOT, 2 RESET. Modelling it
+# as flags[] also generates 3, which tarpit_generic() rejects.
+xt_tarpit_tginfo {
+	variant	int8[0:2]
+}
+
+# chaos_tg_check() returns -ENOENT for the TARPIT/DELUDE variants unless those
+# modules are present; both are built =y here.
+# Likewise an enum: 0 NORMAL, 1 TARPIT, 2 DELUDE.
+xt_chaos_tginfo {
+	variant	int8[0:2]
+}
+
+# ==================== IPMARK (target, rev 1) ====================
+# shift is capped at 31. ipmark_tg4() does "newmark >>= info->shift" on a __u32
+# with no bound check of its own, so 32 and above is undefined behaviour and
+# UBSAN turns it into a panic. Already reproduced; widen to int8 to hunt again.
+xt_ipmark_tginfo {
+	andmask		int32
+	ormask		int32
+	selector	flags[xt_ipmark_sel, int8]
+	shift		int8[0:31]
+}
+
+xt_ipmark_sel = XT_IPMARK_SRC, XT_IPMARK_DST
+
+# ==================== LOGMARK (target, rev 0) ====================
+xt_logmark_tginfo {
+	prefix	array[int8, 14]
+	level	int8
+}
+
+# ==================== PROTO (target, rev 0) ====================
+xt_PROTO_info {
+	mode	flags[xt_proto_mode, int8]
+	proto	int8
+}
+
+xt_proto_mode = XT_PROTO_SET, XT_PROTO_STOP_AT_FRAG, XT_PROTO_STOP_AT_AUTH
+
+# ==================== DHCPMAC (target rev 0 / match rev 0) ====================
+dhcpmac_info {
+	addr	mac_addr
+	mask	int8
+	invert	int8
+}
+
+# ==================== DNETMAP (target, rev 0) ====================
+# prefix is a struct nf_nat_range (40 bytes) followed by __u8 flags and
+# __s32 ttl -> sizeof == 48. If the packaged xtables-addons switched to
+# nf_nat_range2, add base_proto (int16) at the end of nf_nat_range_dnetmap.
+xt_DNETMAP_tginfo {
+	prefix	nf_nat_range_dnetmap
+	flags	flags[xt_dnetmap_flags, int8]
+	ttl	int32
+}
+
+xt_dnetmap_flags = XT_DNETMAP_TTL, XT_DNETMAP_REUSE, XT_DNETMAP_PREFIX, XT_DNETMAP_STATIC, XT_DNETMAP_PERSISTENT, XT_DNETMAP_FULL
+
+# The whole range is pinned. dnetmap_tg_check() walks every address between
+# min_addr and max_addr and kmalloc(GFP_ATOMIC)s an entry for each, and its
+# failure path does a bare "return 0" with dnetmap_mutex still held -- so an
+# unbounded range is both millions of allocations and a guaranteed mutex leak
+# as soon as one of them fails. Sixteen addresses keep the loop short.
+#
+# flags and the proto fields are constant too, so dnetmap_prefix_lookup() always
+# finds the prefix registered by the first rule and just takes a reference. A
+# varying range would make dnetmap_tg_check() call proc_create_data() twice with
+# the same "%pI4_%u" name -- "WARNING: proc registration bug in
+# dnetmap_tg_check". The packet path in dnetmap_tg(), which is most of the file,
+# does not care.
+#
+# 1 is NF_NAT_RANGE_MAP_IPS, without which dnetmap_tg_check() returns -EINVAL.
+nf_nat_range_dnetmap {
+	flags		const[1, int32]
+	min_addr	nf_inet_addr_dnetmap_lo
+	max_addr	nf_inet_addr_dnetmap_hi
+	min_proto	const[0, int16]
+	max_proto	const[0, int16]
+}
+
+# 172.20.20.0 .. 172.20.20.15
+nf_inet_addr_dnetmap_lo [
+	ipv4	const[0xac141400, int32be]
+] [size[16]]
+
+nf_inet_addr_dnetmap_hi [
+	ipv4	const[0xac14140f, int32be]
+] [size[16]]
+
+# ==================== ACCOUNT (target, rev 1) ====================
+# ipt_acc_info: net_ip/net_mask big-endian, table_name (proc name), table_nr set
+# by the kernel. sizeof == 44.
+#ipt_acc_info {
+#	net_ip		ipv4_addr
+#	net_mask	ipv4_addr_mask
+#	table_name	string[xt_addon_names, ACCOUNT_TABLE_NAME_LEN]
+#	table_nr	int32
+#}
