From 2817bc2e2fed456ac7a34c886d69e1edfc11ec85 Mon Sep 17 00:00:00 2001
From: Vasiliy Kovalev <kovalev@altlinux.org>
Date: Thu, 27 Aug 2026 09:40:37 +0000
Subject: [PATCH 2/4] sys/linux: Add xtables-addons descriptions

Seven dedicated IPT_SO_SET_REPLACE skeletons for the grafted matches and
targets, instead of splicing them into the ipt_matches/ipt_targets unions of
netfilter_ipv4.txt.

The generic ipt_replace_t template cannot load a table at all: it points every
hook_entry[] and underflow[] at offset 0, while translate_table() runs
xt_check_table_hooks() first, and that requires both arrays to be strictly
increasing across the valid hooks. Each skeleton here is a k+1 entry table for
k valid hooks -- the addon rule at offset 0, then one unconditional STANDARD
ACCEPT entry per hook -- with num_counters equal to the initial table's entry
count, as xt_replace_table() demands. The rule is reachable from the first hook
only, so e->comefrom stays inside every extension's .hooks mask.

ipt_ip is a wildcard. ip_packet_match() compares addresses, masks and the
interface name, and the upstream ipt_ip fills all of them from random pools, so
a generated rule matched essentially no packet.

ipp2p is omitted (ALT p11 does not ship xt_ipp2p.c) and SYSRQ is omitted
(it triggers a real sysrq action in the guest).
---
 sys/linux/netfilter_xt_addons.txt       | 756 ++++++++++++++++++++++++
 sys/linux/netfilter_xt_addons.txt.const |  74 +++
 2 files changed, 830 insertions(+)
 create mode 100644 sys/linux/netfilter_xt_addons.txt
 create mode 100644 sys/linux/netfilter_xt_addons.txt.const

diff --git a/sys/linux/netfilter_xt_addons.txt b/sys/linux/netfilter_xt_addons.txt
new file mode 100644
index 0000000..845a435
--- /dev/null
+++ b/sys/linux/netfilter_xt_addons.txt
@@ -0,0 +1,756 @@
+# Copyright 2026 alt-syz-box authors. All rights reserved.
+# Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file.
+#
+# syzkaller descriptions for the out-of-tree xtables-addons matches and targets
+# (package kernel-modules-xtables-addons-6.12), grafted into
+# net/netfilter/xtables-addons/ and built into the kernel (=y).
+#
+# WHY THIS FILE DOES NOT REUSE ipt_replace FROM netfilter_ipv4.txt
+# ----------------------------------------------------------------
+# The generic ipt_replace_t template points *every* hook_entry[] and *every*
+# underflow[] at offset 0. translate_table() calls xt_check_table_hooks()
+# before it ever gets to find_check_entry(), and that function requires the
+# hook_entry and underflow arrays to be STRICTLY INCREASING across the valid
+# hooks of the table:
+#
+#	if (max_uflow == info->underflow[i]) { err = "duplicate underflow"; goto error; }
+#	if (max_entry == info->hook_entry[i]) { err = "duplicate entry";    goto error; }
+#
+# Every in-kernel table has at least two valid hooks, so an all-zero hook array
+# is rejected with -EINVAL before a single checkentry runs. That is why the
+# grafted modules show only the coverage of their pernet_operations: no
+# *_mt_check / *_tg_check is ever reached, whatever the descriptions of the
+# match payloads look like.
+#
+# Two more constraints have to be honoured at the same time:
+#
+#  * xt_replace_table() compares num_counters against the *currently installed*
+#    table's entry count ("if (num_counters != private->number) -EAGAIN").
+#    ipt_alloc_initial_table() builds hweight32(valid_hooks) + 1 entries, so
+#    num_counters -- and, to stay idempotent across repeated calls,
+#    num_entries -- must be exactly that.
+#
+#  * check_entry_size_and_hooks() runs check_underflow() on whatever entry sits
+#    at underflow[h]: it must be unconditional (which means *zero* matches,
+#    target_offset == sizeof(struct ipt_entry)) with a STANDARD ACCEPT/DROP
+#    verdict. So the entry an underflow points at can never carry an addon.
+#
+# THE LAYOUT USED HERE
+# --------------------
+# For a table with k valid hooks h0 < h1 < ... < h(k-1), exactly k+1 entries:
+#
+#	offset 0		the addon rule			hook_entry[h0]
+#	offset of p1		unconditional STANDARD ACCEPT	underflow[h0], hook_entry[h1]
+#	offset of p2		unconditional STANDARD ACCEPT	underflow[h1], hook_entry[h2]
+#	...
+#	offset of pk		unconditional STANDARD ACCEPT	underflow[h(k-1)]
+#
+# Both arrays are then strictly increasing, every underflow lands on a policy
+# entry, and the entry count matches the initial table. The offsets are taken
+# with offsetof[entries:pN], which resolves to the offset of pN inside the
+# entries blob -- exactly what hook_entry/underflow are relative to.
+#
+# A useful side effect: the rule is reachable from h0 only, so
+# e->comefrom == 1 << h0 and every .hooks restriction is satisfied.
+# h0 is LOCAL_IN for filter/security and PRE_ROUTING for nat/mangle, which are
+# also the hooks a packet injected by syz_emit_ethernet traverses.
+#
+# valid_hooks itself cannot be narrowed to dodge a .hooks restriction:
+# __do_replace() compares it for equality with the registered table.
+# ipt_ip.proto is pinned per skeleton and IPT_INV_PROTO is excluded from
+# invflags, so the .proto-restricted extensions (TARPIT/DELUDE/lscan need TCP,
+# ECHO/DHCPMAC need UDP) are reachable too.
+#
+# Kernel entry points reached:
+#   *_mt_check / *_tg_check   (checkentry, from IPT_SO_SET_REPLACE)
+#   *_mt / *_tg               (packet path, from syz_emit_ethernet)
+#   procfs / ACCOUNT sockopts (see dev_xt_addons.txt)
+#
+# Note: ipp2p is intentionally absent -- ALT p11 does not ship xt_ipp2p.c, so
+# xt_find_match("ipp2p") fails and takes the whole blob down with it.
+
+include <linux/socket.h>
+include <uapi/linux/netfilter.h>
+include <uapi/linux/netfilter/x_tables.h>
+include <uapi/linux/netfilter_ipv4/ip_tables.h>
+include <uapi/linux/netfilter/xt_addons_compat.h>
+include <linux/netfilter/xt_CHAOS.h>
+include <linux/netfilter/xt_DHCPMAC.h>
+include <linux/netfilter/xt_DNETMAP.h>
+include <linux/netfilter/xt_IPMARK.h>
+include <linux/netfilter/xt_LOGMARK.h>
+include <linux/netfilter/xt_PROTO.h>
+include <linux/netfilter/xt_TARPIT.h>
+include <linux/netfilter/xt_condition.h>
+include <linux/netfilter/xt_fuzzy.h>
+include <linux/netfilter/xt_geoip.h>
+include <linux/netfilter/xt_asn.h>
+include <linux/netfilter/xt_iface.h>
+include <linux/netfilter/xt_ipv4options.h>
+include <linux/netfilter/xt_length2.h>
+include <linux/netfilter/xt_lscan.h>
+include <linux/netfilter/xt_psd.h>
+include <linux/netfilter/xt_quota2.h>
+include <linux/netfilter/xt_pknock.h>
+
+# Self-contained copies of the tables' valid_hooks masks.
+define XA_FILTER_VALID_HOOKS	(1 << NF_INET_LOCAL_IN) | (1 << NF_INET_FORWARD) | (1 << NF_INET_LOCAL_OUT)
+define XA_NAT_VALID_HOOKS	(1 << NF_INET_PRE_ROUTING) | (1 << NF_INET_POST_ROUTING) | (1 << NF_INET_LOCAL_OUT) | (1 << NF_INET_LOCAL_IN)
+define XA_MANGLE_VALID_HOOKS	(1 << NF_INET_PRE_ROUTING) | (1 << NF_INET_LOCAL_IN) | (1 << NF_INET_FORWARD) | (1 << NF_INET_LOCAL_OUT) | (1 << NF_INET_POST_ROUTING)
+define XA_SECURITY_VALID_HOOKS	(1 << NF_INET_LOCAL_IN) | (1 << NF_INET_FORWARD) | (1 << NF_INET_LOCAL_OUT)
+
+# ==================== SYSCALLS ====================
+
+setsockopt$IPT_SO_SET_REPLACE_XA_FILTER(fd sock_in, level const[SOL_IP], opt const[IPT_SO_SET_REPLACE], val ptr[in, ipt_xa_replace_filter], len len[val])
+setsockopt$IPT_SO_SET_REPLACE_XA_FILTER_TCP(fd sock_in, level const[SOL_IP], opt const[IPT_SO_SET_REPLACE], val ptr[in, ipt_xa_replace_filter_tcp], len len[val])
+setsockopt$IPT_SO_SET_REPLACE_XA_FILTER_UDP(fd sock_in, level const[SOL_IP], opt const[IPT_SO_SET_REPLACE], val ptr[in, ipt_xa_replace_filter_udp], len len[val])
+setsockopt$IPT_SO_SET_REPLACE_XA_MANGLE(fd sock_in, level const[SOL_IP], opt const[IPT_SO_SET_REPLACE], val ptr[in, ipt_xa_replace_mangle], len len[val])
+setsockopt$IPT_SO_SET_REPLACE_XA_MANGLE_UDP(fd sock_in, level const[SOL_IP], opt const[IPT_SO_SET_REPLACE], val ptr[in, ipt_xa_replace_mangle_udp], len len[val])
+setsockopt$IPT_SO_SET_REPLACE_XA_NAT(fd sock_in, level const[SOL_IP], opt const[IPT_SO_SET_REPLACE], val ptr[in, ipt_xa_replace_nat], len len[val])
+setsockopt$IPT_SO_SET_REPLACE_XA_SECURITY(fd sock_in, level const[SOL_IP], opt const[IPT_SO_SET_REPLACE], val ptr[in, ipt_xa_replace_security], len len[val])
+setsockopt$IPT_SO_SET_REPLACE_XA_PKNOCK(fd sock_in, level const[SOL_IP], opt const[IPT_SO_SET_REPLACE], val ptr[in, ipt_xa_replace_pknock], len len[val])
+
+# ==================== TABLE SKELETONS ====================
+# k valid hooks -> k+1 entries: the addon rule, then one policy entry per hook.
+# hook_entry[h0] = 0 and hook_entry[h(i)] = offsetof(p(i)); underflow[h(i)] =
+# offsetof(p(i+1)). Both arrays are strictly increasing, as
+# xt_check_table_hooks() demands, and num_entries == num_counters ==
+# hweight32(valid_hooks) + 1 matches ipt_alloc_initial_table(), as
+# xt_replace_table() demands.
+
+ipt_xa_replace_filter {
+	name			string["filter", XT_TABLE_MAXNAMELEN]
+	valid_hooks		const[XA_FILTER_VALID_HOOKS, int32]
+	num_entries		const[4, int32]
+	size			bytesize[entries, int32]
+	hook_pre_routing		ipt_unused
+	hook_local_in			const[0, int32]
+	hook_forward			offsetof[entries:p1, int32]
+	hook_local_out			offsetof[entries:p2, int32]
+	hook_post_routing		ipt_unused
+	underflow_pre_routing	ipt_unused
+	underflow_local_in	offsetof[entries:p1, int32]
+	underflow_forward		offsetof[entries:p2, int32]
+	underflow_local_out	offsetof[entries:p3, int32]
+	underflow_post_routing	ipt_unused
+	num_counters		const[4, int32]
+	counters		ptr[out, array[xt_counters, 4]]
+	entries			ipt_xa_entries_filter
+}
+
+ipt_xa_entries_filter {
+	rule	ipt_xa_entry[ipt_xa_proto_any, xa_matches, xa_filter_targets]
+	p1	ipt_entry_underflow
+	p2	ipt_entry_underflow
+	p3	ipt_entry_underflow
+} [packed, align[PTR_SIZE]]
+
+# filter with ipt_ip.proto pinned to TCP: TARPIT/DELUDE/lscan declare .proto.
+ipt_xa_replace_filter_tcp {
+	name			string["filter", XT_TABLE_MAXNAMELEN]
+	valid_hooks		const[XA_FILTER_VALID_HOOKS, int32]
+	num_entries		const[4, int32]
+	size			bytesize[entries, int32]
+	hook_pre_routing		ipt_unused
+	hook_local_in			const[0, int32]
+	hook_forward			offsetof[entries:p1, int32]
+	hook_local_out			offsetof[entries:p2, int32]
+	hook_post_routing		ipt_unused
+	underflow_pre_routing	ipt_unused
+	underflow_local_in	offsetof[entries:p1, int32]
+	underflow_forward		offsetof[entries:p2, int32]
+	underflow_local_out	offsetof[entries:p3, int32]
+	underflow_post_routing	ipt_unused
+	num_counters		const[4, int32]
+	counters		ptr[out, array[xt_counters, 4]]
+	entries			ipt_xa_entries_filter_tcp
+}
+
+ipt_xa_entries_filter_tcp {
+	rule	ipt_xa_entry[ipt_xa_proto_tcp, xa_matches_tcp, xa_filter_tcp_targets]
+	p1	ipt_entry_underflow
+	p2	ipt_entry_underflow
+	p3	ipt_entry_underflow
+} [packed, align[PTR_SIZE]]
+
+# filter with ipt_ip.proto pinned to UDP: ECHO and the dhcpmac match.
+ipt_xa_replace_filter_udp {
+	name			string["filter", XT_TABLE_MAXNAMELEN]
+	valid_hooks		const[XA_FILTER_VALID_HOOKS, int32]
