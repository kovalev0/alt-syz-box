From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vasiliy Kovalev <kovalev@altlinux.org>
Date: Mon, 28 Sep 2026 10:40:00 +0000
Subject: [PATCH] sys/linux, executor: add MD software RAID descriptions and
 syz_md_setup

Adds the MD software RAID ioctl ABI, the /sys/block/md0/md/ attributes and
the dm-raid target, plus syz_md_setup, which assembles a legacy array over
ram disks so a RAID personality actually runs.

---
 executor/common_linux.h      |  75 +++++++++++++++++++
 pkg/vminfo/linux_syscalls.go |   1 +
 sys/linux/dev_md.txt         | 140 +++++++++++++++++++++++++++++++++++
 sys/linux/dev_md.txt.const   |  28 +++++++
 4 files changed, 244 insertions(+)
 create mode 100644 sys/linux/dev_md.txt
 create mode 100644 sys/linux/dev_md.txt.const

diff --git a/executor/common_linux.h b/executor/common_linux.h
index 3831598..fcaee72 100644
--- a/executor/common_linux.h
+++ b/executor/common_linux.h
@@ -33,6 +33,81 @@
 }
 #endif
 
+#if SYZ_EXECUTOR || __NR_syz_md_setup
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+
+// Assemble a legacy (non-persistent) MD array over ram disks via the ioctl path
+// SET_ARRAY_INFO + ADD_NEW_DISK + RUN_ARRAY (what "mdadm --build" does), so md.c
+// and the personality (raid0/raid1/raid10/...) run() are reached. Random fuzzing
+// rarely emits this exact stateful sequence on its own.
+struct syz_mdu_array_info {
+	int major_version, minor_version, patch_version;
+	unsigned int ctime;
+	int level, size, nr_disks, raid_disks, md_minor, not_persistent;
+	unsigned int utime;
+	int state, active_disks, working_disks, failed_disks, spare_disks;
+	int layout, chunk_size;
+};
+struct syz_mdu_disk_info {
+	int number, major, minor, raid_disk, state;
+};
+struct syz_mdu_param {
+	int personality, chunk_size, max_fault;
+};
+#define SYZ_SET_ARRAY_INFO _IOW(9, 0x23, struct syz_mdu_array_info)
+#define SYZ_ADD_NEW_DISK   _IOW(9, 0x21, struct syz_mdu_disk_info)
+#define SYZ_RUN_ARRAY      _IOW(9, 0x30, struct syz_mdu_param)
+
+static long syz_md_setup(volatile long a0, volatile long a1, volatile long a2, volatile long a3)
+{
+	int level = (int)a0;
+	int ndisks = (int)a1;
+	int i, fd;
+	struct syz_mdu_array_info ai;
+	struct syz_mdu_param param;
+
+	if (ndisks < 1)
+		ndisks = 1;
+	if (ndisks > 6)
+		ndisks = 6;
+	mknod("/dev/md0", S_IFBLK | 0600, makedev(9, 0));
+	fd = open("/dev/md0", O_RDWR);
+	if (fd == -1)
+		return -1;
+
+	memset(&ai, 0, sizeof(ai));
+	ai.major_version = 0;
+	ai.minor_version = 0;
+	ai.level = level;
+	ai.raid_disks = ndisks;
+	ai.nr_disks = ndisks;
+	ai.md_minor = 0;
+	ai.not_persistent = 1;
+	ai.size = (int)a3;
+	ai.chunk_size = (int)a2 * 1024;
+	ioctl(fd, SYZ_SET_ARRAY_INFO, &ai);
+
+	for (i = 0; i < ndisks; i++) {
+		struct syz_mdu_disk_info di;
+		memset(&di, 0, sizeof(di));
+		di.number = i;
+		di.major = 1;    // ram disk major
+		di.minor = i;    // /dev/ram<i>
+		di.raid_disk = i;
+		di.state = (1 << 1) | (1 << 2); // MD_DISK_ACTIVE | MD_DISK_SYNC
+		ioctl(fd, SYZ_ADD_NEW_DISK, &di);
+	}
+
+	memset(&param, 0, sizeof(param));
+	ioctl(fd, SYZ_RUN_ARRAY, &param);
+	return fd;
+}
+#endif
+
 #if SYZ_EXECUTOR || __NR_syz_open_dev
 #include <fcntl.h>
 #include <string.h>
