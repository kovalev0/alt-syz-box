diff --git a/sys/linux/dev_md.txt b/sys/linux/dev_md.txt
new file mode 100644
index 0000000..a394723
--- /dev/null
+++ b/sys/linux/dev_md.txt
@@ -0,0 +1,140 @@
+include <linux/fcntl.h>
+include <linux/major.h>
+include <uapi/linux/dm-ioctl.h>
+include <uapi/linux/raid/md_u.h>
+
+# ==================== RESOURCES ====================
+
+resource fd_md[fd_block]
+resource fd_md_sysfs[fd]
+
+# ==================== IOCTLS / CALLS ====================
+
+openat$md_dev(fd const[AT_FDCWD], file ptr[in, string["/dev/md0"]], flags flags[open_flags], mode const[0]) fd_md
+
+ioctl$RAID_VERSION(fd fd_md, cmd const[RAID_VERSION], arg ptr[out, mdu_version])
+ioctl$GET_ARRAY_INFO(fd fd_md, cmd const[GET_ARRAY_INFO], arg ptr[out, mdu_array_info])
+ioctl$GET_DISK_INFO(fd fd_md, cmd const[GET_DISK_INFO], arg ptr[inout, mdu_disk_info])
+ioctl$GET_BITMAP_FILE(fd fd_md, cmd const[GET_BITMAP_FILE], arg ptr[out, array[int8, 4096]])
+
+ioctl$SET_ARRAY_INFO(fd fd_md, cmd const[SET_ARRAY_INFO], arg ptr[in, mdu_array_info])
+ioctl$SET_ARRAY_INFO_null(fd fd_md, cmd const[SET_ARRAY_INFO], arg const[0])
+
+ioctl$ADD_NEW_DISK(fd fd_md, cmd const[ADD_NEW_DISK], arg ptr[in, mdu_disk_info])
+
+ioctl$HOT_ADD_DISK(fd fd_md, cmd const[HOT_ADD_DISK], arg flags[md_devnos])
+ioctl$HOT_REMOVE_DISK(fd fd_md, cmd const[HOT_REMOVE_DISK], arg flags[md_devnos])
+ioctl$SET_DISK_FAULTY(fd fd_md, cmd const[SET_DISK_FAULTY], arg flags[md_devnos])
+
+ioctl$RUN_ARRAY(fd fd_md, cmd const[RUN_ARRAY], arg ptr[in, mdu_param])
+ioctl$STOP_ARRAY(fd fd_md, cmd const[STOP_ARRAY], arg const[0])
+ioctl$STOP_ARRAY_RO(fd fd_md, cmd const[STOP_ARRAY_RO], arg const[0])
+ioctl$RESTART_ARRAY_RW(fd fd_md, cmd const[RESTART_ARRAY_RW], arg const[0])
+ioctl$CLEAR_ARRAY(fd fd_md, cmd const[CLEAR_ARRAY], arg const[0])
+ioctl$PROTECT_ARRAY(fd fd_md, cmd const[PROTECT_ARRAY], arg const[0])
+ioctl$UNPROTECT_ARRAY(fd fd_md, cmd const[UNPROTECT_ARRAY], arg const[0])
+ioctl$CLUSTERED_DISK_NACK(fd fd_md, cmd const[CLUSTERED_DISK_NACK], arg const[0])
+ioctl$RAID_AUTORUN(fd fd_md, cmd const[RAID_AUTORUN], arg const[0])
+
+ioctl$SET_BITMAP_FILE(fd fd_md, cmd const[SET_BITMAP_FILE], arg fd)
+ioctl$SET_BITMAP_FILE_none(fd fd_md, cmd const[SET_BITMAP_FILE], arg const[0xffffffffffffffff])
+
+# ==================== STRUCTS ====================
+
+mdu_version {
+	major		int32
+	minor		int32
+	patchlevel	int32
+}
+
+mdu_array_info {
+	major_version	flags[md_sb_versions, int32]
+	minor_version	int32[0:2]
+	patch_version	int32[0:2]
+	ctime		int32
+	level		flags[md_levels, int32]
+	size		flags[md_sizes, int32]
+	nr_disks	int32[0:8]
+	raid_disks	int32[0:8]
+	md_minor	int32[0:4]
+	not_persistent	int32[0:1]
+	utime		int32
+	state		flags[md_sb_states, int32]
+	active_disks	int32[0:8]
+	working_disks	int32[0:8]
+	failed_disks	int32[0:8]
+	spare_disks	int32[0:8]
+	layout		flags[md_layouts, int32]
+	chunk_size	flags[md_chunk_sizes, int32]
+}
+
+mdu_disk_info {
+	number		int32[0:8]
+	major		flags[md_disk_majors, int32]
+	minor		int32[0:8]
+	raid_disk	int32[0:8]
+	state		flags[md_disk_states, int32]
+}
+
+mdu_param {
+	personality	int32[0:16]
+	chunk_size	flags[md_chunk_sizes, int32]
+	max_fault	int32[0:4]
+}
+
+# ==================== FLAGS & PARAMS ====================
+
+md_sb_versions = 0, 1, 2, 90, 4294967295
+
+md_levels = 0, 1, 4, 5, 6, 10, 18446744073709551615, 18446744073709551612, 18446744073708551616
+
+md_sizes = 0, 1, 64, 1024, 32768, 65536, 2147483647
+
+md_chunk_sizes = 0, 512, 4096, 65536, 524288, 1, 2147483647
+
+md_layouts = 0, 1, 2, 3, 4, 5, 257, 258, 65537, 131073, 2147483647
+
+md_sb_states = 1, 2, 256, 512
+
+md_disk_majors = 1, 7, 0, 259
+
+md_disk_states = 1, 2, 4, 8, 16, 32, 512, 1024, 262144
+
+md_devnos = 256, 257, 258, 259, 260, 1792, 1793, 0
+
+openat$md_sysfs(fd const[AT_FDCWD], file ptr[in, string[md_sysfs_files]], flags flags[open_flags], mode const[0]) fd_md_sysfs
+read$md_sysfs(fd fd_md_sysfs, buf ptr[out, array[int8]], count bytesize[buf])
+write$md_sysfs(fd fd_md_sysfs, buf ptr[in, string[md_sysfs_values]], count bytesize[buf])
+
+md_sysfs_files = "/sys/block/md0/md/level", "/sys/block/md0/md/raid_disks", "/sys/block/md0/md/chunk_size", "/sys/block/md0/md/component_size", "/sys/block/md0/md/layout", "/sys/block/md0/md/resync_start", "/sys/block/md0/md/metadata_version", "/sys/block/md0/md/new_dev", "/sys/block/md0/md/safe_mode_delay", "/sys/block/md0/md/array_state", "/sys/block/md0/md/array_size", "/sys/block/md0/md/sync_action", "/sys/block/md0/md/sync_speed_min", "/sys/block/md0/md/sync_speed_max", "/sys/block/md0/md/sync_force_parallel", "/sys/block/md0/md/sync_completed", "/sys/block/md0/md/suspend_lo", "/sys/block/md0/md/suspend_hi", "/sys/block/md0/md/reshape_position", "/sys/block/md0/md/reshape_direction", "/sys/block/md0/md/consistency_policy", "/sys/block/md0/md/degraded", "/sys/block/md0/md/uuid", "/sys/block/md0/md/serialize_policy", "/sys/block/md0/md/fail_last_dev", "/sys/block/md0/md/bitmap/location", "/sys/block/md0/md/bitmap/chunksize", "/sys/block/md0/md/bitmap/time_base", "/sys/block/md0/md/bitmap/backlog", "/sys/block/md0/md/bitmap/max_backlog_used", "/sys/block/md0/md/bitmap/metadata", "/sys/block/md0/md/bitmap/can_clear", "/sys/block/md0/md/bitmap/space"
+
+md_sysfs_values = "0", "1", "-1", "none", "clear", "inactive", "readonly", "read-auto", "clean", "active", "write_pending", "active-idle", "broken", "idle", "frozen", "resync", "recover", "check", "repair", "reshape", "backwards", "forwards", "internal", "external", "external:-dev", "external:/dev/ram0", "+8", "-8", "4096", "65536", "18446744073709551615", "2147483647", "9:0", "1.2", "0.90", "unknown", "", "                    ", "0 0", "raid0", "raid1", "raid5", "raid10", "linear"
+
+ioctl$DM_TABLE_LOAD_raid(fd fd_dm_control, cmd const[DM_TABLE_LOAD], arg ptr[inout, dm_load_raid])
+type dm_load_raid dm_ioctl_t[1, dm_ident_name, flags[dm_ioctl_flags, int32], dm_target_raid]
+dm_target_raid {
+	sector_start	const[0, int64]
+	length		flags[dm_target_lengths, int64]
+	status		const[0, int32]
+	next		len[parent, int32]
+	target_type	string["raid", DM_MAX_TYPE_NAME]
+	params		string[dm_params_raid, 96]
+}
+dm_params_raid = "raid0 1 64 2 - 1:0 - 1:1", "raid1 1 2 2 - 1:0 - 1:1", "raid1 3 2 sync region_size 1024 2 - 1:0 - 1:1", "raid5_ls 1 64 3 - 1:0 - 1:1 - 1:2", "raid6_zr 1 64 4 - 1:0 - 1:1 - 1:2 - 1:3", "raid10 1 64 4 - 1:0 - 1:1 - 1:2 - 1:3", "raid4 1 0 3 - 1:0 - 1:1 - 1:2", "bogus 1 64 2 - 1:0 - 1:1", "raid1 1 2 0"
+
+syz_md_setup(level intptr[0:10], ndisks intptr[1:6], chunk_kb intptr[0:1024], size_kb intptr[0:65536]) fd_md
+
+syz_dm_setup$raid(index intptr[0:7], target ptr[in, string["raid"]], params ptr[in, string[dm_params_raid]], sectors flags[dm_target_lengths]) fd_dm
+
+type dm_load_raidj dm_ioctl_t[1, dm_ident_name, flags[dm_ioctl_flags, int32], dm_target_raidj]
+dm_target_raidj {
+	sector_start	const[0, int64]
+	length		flags[dm_target_lengths, int64]
+	status		const[0, int32]
+	next		len[parent, int32]
+	target_type	string["raid", DM_MAX_TYPE_NAME]
+	params		string[dm_params_raidj, 96]
+}
+ioctl$DM_TABLE_LOAD_raidj(fd fd_dm_control, cmd const[DM_TABLE_LOAD], arg ptr[inout, dm_load_raidj])
+syz_dm_setup$raidj(index intptr[0:7], target ptr[in, string["raid"]], params ptr[in, string[dm_params_raidj]], sectors flags[dm_target_lengths]) fd_dm
+dm_params_raidj = "raid5_ls 3 64 journal_dev 1:6 3 - 1:0 - 1:1 - 1:2", "raid5_ls 2 64 ppl 3 - 1:0 - 1:1 - 1:2", "raid6_nc 3 64 journal_dev 1:6 4 - 1:0 - 1:1 - 1:2 - 1:3", "raid1 3 0 write_mostly 0 2 - 1:0 - 1:1", "raid1 3 0 max_write_behind 4 2 - 1:0 - 1:1", "raid5_ls 3 64 delta_disks 1 3 - 1:0 - 1:1 - 1:2", "raid5_rs 3 64 data_offset 2048 3 - 1:0 - 1:1 - 1:2", "raid5_la 1 64 3 - 1:0 - 1:1 - 1:2"
