From f0a687761d70c9748ebf729f8d592cba12209c92 Mon Sep 17 00:00:00 2001
From: Vasiliy Kovalev <kovalev@altlinux.org>
Date: Mon, 31 Aug 2026 10:00:00 +0000
Subject: [PATCH] sys/linux, executor: add device-mapper descriptions and
 syz_dm_setup

Adds the /dev/mapper/control ioctl ABI and syz_dm_setup, a pseudo-syscall
that creates, loads and resumes a device-mapper target in one step so its
.map callback is actually reachable. Only linear, zero and error are enabled.

---
 executor/common_linux.h      | 140 +++++++++++
 pkg/vminfo/linux_syscalls.go |   1 +
 sys/linux/dev_dm.txt         | 446 +++++++++++++++++++++++++++++++++++
 sys/linux/dev_dm.txt.const   |  48 ++++
 4 files changed, 635 insertions(+)
 create mode 100644 sys/linux/dev_dm.txt
 create mode 100644 sys/linux/dev_dm.txt.const

diff --git a/executor/common_linux.h b/executor/common_linux.h
index c1368f2..3b85154 100644
--- a/executor/common_linux.h
+++ b/executor/common_linux.h
@@ -2433,6 +2433,146 @@ static long syz_extract_tcp_res(volatile long a0, volatile long a1, volatile lon
 #include "common_usb_linux.h"
 #endif
 
+#if SYZ_EXECUTOR || __NR_syz_dm_setup
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+// syz_dm_setup(index intptr, target ptr[in, string], params ptr[in, string], sectors intptr) fd
+//
+// Creates (or reuses) a mapped device, loads a single-target table onto it,
+// resumes it, and returns an fd on the resulting block device.
+//
+// A program can do this by hand -- DM_DEV_CREATE, DM_TABLE_LOAD,
+// DM_DEV_SUSPEND, open of /dev/dm-N -- but not by chance. The three ioctls have
+// to agree on a device name that syzkaller draws independently for each of
+// them; the table only becomes live if DM_SUSPEND_FLAG happens to be absent,
+// because do_resume() is the sole path that swaps an inactive table in; and the
+// minor of the resulting node is whatever dm's idr hands out. Until all four
+// line up dm_submit_bio() answers every bio with "mapping table unavailable,
+// erroring io" and the target is never entered at all.
+//
+// The device name and minor are derived from index, so devices are reused
+// rather than accumulated, and two procs picking the same index race on
+// suspend/resume, which is itself worth covering.
+//
+// Structures are spelled out locally rather than pulled from
+// <linux/dm-ioctl.h> so that generated C reproducers build anywhere.
+#define SYZ_DM_NAME_LEN 128
+#define SYZ_DM_UUID_LEN 129
+#define SYZ_DM_TYPE_LEN 16
+#define SYZ_DM_IOCTL_SIZE 312
+#define SYZ_DM_VERSION_MAJOR 4
+#define SYZ_DM_PERSISTENT_DEV_FLAG 8
+
+struct syz_dm_ioctl {
+	uint32 version[3];
+	uint32 data_size;
+	uint32 data_start;
+	uint32 target_count;
+	int open_count;
+	uint32 flags;
+	uint32 event_nr;
+	uint32 padding;
+	uint64 dev;
+	char name[SYZ_DM_NAME_LEN];
+	char uuid[SYZ_DM_UUID_LEN];
+	char data[7];
+};
+
+struct syz_dm_target_spec {
+	uint64 sector_start;
+	uint64 length;
+	int status;
+	uint32 next;
+	char target_type[SYZ_DM_TYPE_LEN];
+};
+
+#define SYZ_DM_IOCTL(nr) _IOWR(0xfd, nr, struct syz_dm_ioctl)
+
+static void syz_dm_hdr(struct syz_dm_ioctl* dmi, const char* name)
+{
+	memset(dmi, 0, SYZ_DM_IOCTL_SIZE);
+	dmi->version[0] = SYZ_DM_VERSION_MAJOR;
+	dmi->version[1] = 0;
+	dmi->version[2] = 0;
+	dmi->data_size = SYZ_DM_IOCTL_SIZE;
+	dmi->data_start = SYZ_DM_IOCTL_SIZE;
+	strncpy(dmi->name, name, SYZ_DM_NAME_LEN - 1);
+}
+
+static long syz_dm_setup(volatile long a0, volatile long a1, volatile long a2, volatile long a3)
+{
+	unsigned index = (unsigned)a0 & 7;
+	const char* target = (const char*)a1;
+	const char* params = (const char*)a2;
+	uint64 sectors = (uint64)a3;
+
+	char buf[SYZ_DM_IOCTL_SIZE + sizeof(struct syz_dm_target_spec) + 512];
+	struct syz_dm_ioctl* dmi = (struct syz_dm_ioctl*)buf;
+	struct syz_dm_target_spec* spec =
+	    (struct syz_dm_target_spec*)(buf + SYZ_DM_IOCTL_SIZE);
+	char* pstr = (char*)(spec + 1);
+	char name[SYZ_DM_NAME_LEN];
+	char node[64];
+	size_t plen;
+	int ctl, fd;
+
+	if (SYZ_DM_IOCTL_SIZE != sizeof(struct syz_dm_ioctl))
+		return -1;
+
+	ctl = open("/dev/mapper/control", O_RDWR);
+	if (ctl == -1)
+		return -1;
+	snprintf(name, sizeof(name), "syzdm%u", index);
+
+	// Create. An existing device from an earlier program is fine: the table
+	// load below simply replaces its inactive table.
+	syz_dm_hdr(dmi, name);
+	dmi->flags = SYZ_DM_PERSISTENT_DEV_FLAG;
+	dmi->dev = index;
+	ioctl(ctl, SYZ_DM_IOCTL(3), dmi);
+
+	// Load a single-target table.
+	memset(buf, 0, sizeof(buf));
+	syz_dm_hdr(dmi, name);
+	dmi->target_count = 1;
+	spec->sector_start = 0;
+	spec->length = sectors;
+	strncpy(spec->target_type, target, SYZ_DM_TYPE_LEN - 1);
+	strncpy(pstr, params, 511);
+	pstr[511] = 0;
+	plen = strlen(pstr) + 1;
+	spec->next = sizeof(struct syz_dm_target_spec) + plen;
+	dmi->data_size = SYZ_DM_IOCTL_SIZE + sizeof(struct syz_dm_target_spec) + plen;
+	if (ioctl(ctl, SYZ_DM_IOCTL(9), dmi) != 0) {
+		close(ctl);
+		return -1;
+	}
+
+	// Resume. flags has no DM_SUSPEND_FLAG, so dev_suspend() takes the
+	// do_resume() branch, which is what makes the table live.
+	syz_dm_hdr(dmi, name);
+	ioctl(ctl, SYZ_DM_IOCTL(6), dmi);
+	close(ctl);
+
+	snprintf(node, sizeof(node), "/dev/dm-%u", index);
+	fd = open(node, O_RDWR);
+	if (fd == -1) {
+		// devtmpfs may be absent; make a private node instead.
+		snprintf(node, sizeof(node), "./syzdm%u", index);
+		mknod(node, S_IFBLK | 0600, makedev(dmi->dev >> 20, dmi->dev & 0xfffff));
+		fd = open(node, O_RDWR);
+	}
+	return fd;
+}
+#endif
+
 #if SYZ_EXECUTOR || __NR_syz_open_dev
 #include <fcntl.h>
 #include <string.h>
