From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vasiliy Kovalev <kovalev@altlinux.org>
Date: Mon, 12 Oct 2026 10:09:08 +0000
Subject: [PATCH] sys/linux: add dm-vdo target descriptions

Constructor grammar for the dm-vdo target: inline deduplication, compression
and thin provisioning.

---
 sys/linux/dev_dm_vdo.txt       | 25 +++++++++++++++++++++++++
 sys/linux/dev_dm_vdo.txt.const |  5 +++++
 2 files changed, 30 insertions(+)
 create mode 100644 sys/linux/dev_dm_vdo.txt
 create mode 100644 sys/linux/dev_dm_vdo.txt.const

diff --git a/sys/linux/dev_dm_vdo.txt b/sys/linux/dev_dm_vdo.txt
new file mode 100644
index 0000000..59dc4a8
--- /dev/null
+++ b/sys/linux/dev_dm_vdo.txt
@@ -0,0 +1,25 @@
+include <linux/ioctl.h>
+include <uapi/linux/dm-ioctl.h>
+
+# ==================== IOCTLS / CALLS ====================
+
+ioctl$DM_TABLE_LOAD_vdo(fd fd_dm_control, cmd const[DM_TABLE_LOAD], arg ptr[inout, dm_load_vdo])
+
+# ==================== STRUCTS ====================
+
+type dm_load_vdo dm_ioctl_t[1, dm_ident_name, flags[dm_ioctl_flags, int32], dm_target_vdo]
+
+dm_target_vdo {
+	sector_start	const[0, int64]
+	length		flags[dm_target_lengths, int64]
+	status		const[0, int32]
+	next		len[parent, int32]
+	target_type	string["vdo", DM_MAX_TYPE_NAME]
+	params		string[dm_params_vdo, 128]
+}
+
+syz_dm_setup$vdo(index intptr[0:7], target ptr[in, string["vdo"]], params ptr[in, string[dm_params_vdo]], sectors flags[dm_target_lengths]) fd_dm
+
+# ==================== FLAGS & PARAMS ====================
+
+dm_params_vdo = "V4 1:0 262144 4096 32768 16380", "V4 1:0 8192 4096 1024 512", "V4 1:0 262144 512 65550 5000 hash 1 logical 3 physical 2", "V4 1:0 262144 4096 32768 16380 maxDiscard 8", "V4 1:0 262144 4096 32768 16380 deduplication off compression on", "V4 1:0 262144 4096 32768 16380 ackThreads 2 bioThreads 4 cpuThreads 1", "V4 1:0 0 4096 0 0", "V4 1:0 262144 4096 32768 16380 compression on", "bogus 1:0 262144 4096 32768 16380", "V4 1:0 262144 4096 32768 16380 bioRotationInterval 8"
diff --git a/sys/linux/dev_dm_vdo.txt.const b/sys/linux/dev_dm_vdo.txt.const
new file mode 100644
index 0000000..f4f565a
--- /dev/null
+++ b/sys/linux/dev_dm_vdo.txt.const
@@ -0,0 +1,5 @@
+# Code generated by syz-sysgen. DO NOT EDIT.
+arches = amd64
+DM_MAX_TYPE_NAME = amd64:16
+DM_TABLE_LOAD = amd64:3241737481
+__NR_ioctl = amd64:16
