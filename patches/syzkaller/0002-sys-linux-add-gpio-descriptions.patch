+GPIOHANDLE_SET_CONFIG_IOCTL = amd64:3226776586
+GPIOHANDLE_SET_LINE_VALUES_IOCTL = amd64:3225465865
+GPIO_GET_CHIPINFO_IOCTL = amd64:2151986177
+GPIO_GET_LINEEVENT_IOCTL = amd64:3224417284
+GPIO_GET_LINEHANDLE_IOCTL = amd64:3245126659
+GPIO_GET_LINEINFO_IOCTL = amd64:3225990146
+GPIO_GET_LINEINFO_UNWATCH_IOCTL = amd64:3221533708
+GPIO_GET_LINEINFO_WATCH_IOCTL = amd64:3225990155
+GPIO_V2_GET_LINEINFO_IOCTL = amd64:3238048773
+GPIO_V2_GET_LINEINFO_WATCH_IOCTL = amd64:3238048774
+GPIO_V2_GET_LINE_IOCTL = amd64:3260068871
+GPIO_V2_LINE_ATTR_ID_DEBOUNCE = amd64:3
+GPIO_V2_LINE_ATTR_ID_FLAGS = amd64:1
+GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES = amd64:2
+GPIO_V2_LINE_FLAG_ACTIVE_LOW = amd64:2
+GPIO_V2_LINE_FLAG_BIAS_DISABLED = amd64:1024
+GPIO_V2_LINE_FLAG_BIAS_PULL_DOWN = amd64:512
+GPIO_V2_LINE_FLAG_BIAS_PULL_UP = amd64:256
+GPIO_V2_LINE_FLAG_EDGE_FALLING = amd64:32
+GPIO_V2_LINE_FLAG_EDGE_RISING = amd64:16
+GPIO_V2_LINE_FLAG_EVENT_CLOCK_HTE = amd64:4096
+GPIO_V2_LINE_FLAG_EVENT_CLOCK_REALTIME = amd64:2048
+GPIO_V2_LINE_FLAG_INPUT = amd64:4
+GPIO_V2_LINE_FLAG_OPEN_DRAIN = amd64:64
+GPIO_V2_LINE_FLAG_OPEN_SOURCE = amd64:128
+GPIO_V2_LINE_FLAG_OUTPUT = amd64:8
+GPIO_V2_LINE_FLAG_USED = amd64:1
+GPIO_V2_LINE_GET_VALUES_IOCTL = amd64:3222320142
+GPIO_V2_LINE_SET_CONFIG_IOCTL = amd64:3239097357
+GPIO_V2_LINE_SET_VALUES_IOCTL = amd64:3222320143
+O_WRONLY = amd64:1
+__NR_ioctl = amd64:16
+__NR_mkdirat = amd64:258
+__NR_openat = amd64:257
+__NR_read = amd64:0
+__NR_rmdir = amd64:84
