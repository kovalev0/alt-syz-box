index 2cd5e95..420487e 100644
--- a/pkg/vminfo/linux_syscalls.go
+++ b/pkg/vminfo/linux_syscalls.go
@@ -73,6 +73,7 @@ var linuxSyscallChecks = map[string]func(*checkContext, *prog.Syscall) string{
 	"syz_dm_setup":                  alwaysSupported,
 	"syz_dmz_io":                    alwaysSupported,
 	"syz_md_setup":              alwaysSupported,
+	"syz_bcache_setup":              alwaysSupported,
 	"syz_execute_func":              alwaysSupported,
 	"syz_emit_ethernet":             linuxNetInjectionSupported,
 	"syz_extract_tcp_res":           linuxNetInjectionSupported,
diff --git a/sys/linux/dev_bcache.txt b/sys/linux/dev_bcache.txt
new file mode 100644
index 0000000..c79a9bf
--- /dev/null
+++ b/sys/linux/dev_bcache.txt
@@ -0,0 +1,84 @@
+include <uapi/linux/fcntl.h>
+include <uapi/linux/fs.h>
+
+# ==================== RESOURCES ====================
+
+resource fd_bcache_ctl[fd]
+resource fd_bcache_bdev[fd]
+resource fd_bcache_sysfs[fd]
+resource fd_bcache[fd]
+
+# ==================== IOCTLS / CALLS ====================
+
+syz_bcache_setup(dev intptr[0:7], type intptr[0:1], mode intptr[0:7], flush const[0]) fd_bcache
+
+read$bcache(fd fd_bcache, buf ptr[out, array[int8]], count bytesize[buf])
+write$bcache(fd fd_bcache, buf ptr[in, array[int8]], count bytesize[buf])
+pread64$bcache(fd fd_bcache, buf ptr[out, array[int8]], count bytesize[buf], pos intptr)
+pwrite64$bcache(fd fd_bcache, buf ptr[in, array[int8]], count bytesize[buf], pos intptr)
+fsync$bcache(fd fd_bcache)
+ioctl$bcache_BLKFLSBUF(fd fd_bcache, cmd const[BLKFLSBUF])
+
+openat$bcache_register(fd const[AT_FDCWD], file ptr[in, string["/sys/fs/bcache/register"]], flags flags[open_flags], mode const[0]) fd_bcache_ctl
+openat$bcache_register_quiet(fd const[AT_FDCWD], file ptr[in, string["/sys/fs/bcache/register_quiet"]], flags flags[open_flags], mode const[0]) fd_bcache_ctl
+openat$bcache_pendings_cleanup(fd const[AT_FDCWD], file ptr[in, string["/sys/fs/bcache/pendings_cleanup"]], flags flags[open_flags], mode const[0]) fd_bcache_ctl
+
+write$bcache_register(fd fd_bcache_ctl, data ptr[in, string[bcache_reg_devs]], len bytesize[data])
+write$bcache_register_quiet(fd fd_bcache_ctl, data ptr[in, string[bcache_reg_devs]], len bytesize[data])
+write$bcache_pendings_cleanup(fd fd_bcache_ctl, data ptr[in, string["1"]], len bytesize[data])
+
+# ==================== FLAGS & PARAMS ====================
+
+bcache_reg_devs = "/dev/ram0", "/dev/ram1", "/dev/ram2", "/dev/ram3", "/dev/sda", ""
+
+openat$bcache_sysfs(fd const[AT_FDCWD], file ptr[in, string[bcache_sysfs_files]], flags flags[open_flags], mode const[0]) fd_bcache_sysfs
+read$bcache_sysfs(fd fd_bcache_sysfs, buf ptr[out, array[int8]], count bytesize[buf])
+write$bcache_sysfs(fd fd_bcache_sysfs, data ptr[in, string[bcache_sysfs_vals]], len bytesize[data])
+
+bcache_sysfs_files = "/sys/module/bcache/parameters/latency_warn_ms", "/sys/module/bcache/parameters/bch_cutoff_writeback", "/sys/module/bcache/parameters/bch_cutoff_writeback_sync", "/sys/block/bcache0/bcache/cache_mode", "/sys/block/bcache0/bcache/writeback_running", "/sys/block/bcache0/bcache/writeback_percent", "/sys/block/bcache0/bcache/writeback_delay", "/sys/block/bcache0/bcache/writeback_rate", "/sys/block/bcache0/bcache/writeback_rate_update_seconds", "/sys/block/bcache0/bcache/writeback_rate_minimum", "/sys/block/bcache0/bcache/sequential_cutoff", "/sys/block/bcache0/bcache/readahead_cache_policy", "/sys/block/bcache0/bcache/label", "/sys/block/bcache0/bcache/attach", "/sys/block/bcache0/bcache/detach", "/sys/block/bcache0/bcache/stop", "/sys/block/bcache0/bcache/clear_stats", "/sys/block/bcache0/bcache/running", "/sys/block/bcache0/bcache/dirty_data"
+
+bcache_sysfs_vals = "writeback", "writethrough", "writearound", "none", "0", "1", "40", "100", "1000000", "all", "meta", "10", "-1", "3000000000000000000"
+
+openat$bcache_bdev(fd const[AT_FDCWD], file ptr[in, string[bcache_reg_devs]], flags flags[open_flags], mode const[0]) fd_bcache_bdev
+pwrite64$bcache_sb(fd fd_bcache_bdev, buf ptr[in, bcache_sb], count bytesize[buf], pos const[4096])
+
+# ==================== STRUCTS ====================
+
+bcache_sb {
+	csum		int64
+	sb_offset	const[8, int64]
+	version		flags[bcache_sb_versions, int64]
+	magic0		const[0xc6, int8]
+	magic1		const[0x85, int8]
+	magic2		const[0x73, int8]
+	magic3		const[0xf6, int8]
+	magic4		const[0x4e, int8]
+	magic5		const[0x1a, int8]
+	magic6		const[0x45, int8]
+	magic7		const[0xca, int8]
+	magic8		const[0x82, int8]
+	magic9		const[0x65, int8]
+	magic10		const[0xf5, int8]
+	magic11		const[0x7f, int8]
+	magic12		const[0x48, int8]
+	magic13		const[0xba, int8]
+	magic14		const[0x6d, int8]
+	magic15		const[0x81, int8]
+	uuid		array[int8, 16]
+	set_uuid	array[int8, 16]
+	label		array[int8, 32]
+	flags		int64
+	seq		int64
+	pad		array[const[0, int64], 8]
+	nbuckets	int64[0:0x100000]
+	block_size	int16[0:16]
+	bucket_size	int16[0:2048]
+	nr_in_set	int16[0:8]
+	nr_this_dev	int16[0:8]
+	last_mount	int32
+	first_bucket	int16[0:16]
+	njournal	int16[0:256]
+	d		array[const[0, int64], 256]
+} [packed]
+
+bcache_sb_versions = 0, 1, 3, 4, 5, 6, 2, 99
