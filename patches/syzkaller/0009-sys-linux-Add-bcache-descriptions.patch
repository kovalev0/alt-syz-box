From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vasiliy Kovalev <kovalev@altlinux.org>
Date: Mon, 19 Oct 2026 10:55:00 +0000
Subject: [PATCH] sys/linux, executor: add bcache descriptions and
 syz_bcache_setup

Adds bcache descriptions and syz_bcache_setup, which writes a valid
superblock and registers a device so a cache set runs and a backing device
attaches.
---
 executor/common_linux.h        | 107 +++++++++++++++++++++++++++++++++
 pkg/vminfo/linux_syscalls.go   |   1 +
 sys/linux/dev_bcache.txt       |  84 ++++++++++++++++++++++++++
 sys/linux/dev_bcache.txt.const |  11 ++++
 4 files changed, 203 insertions(+)
 create mode 100644 sys/linux/dev_bcache.txt
 create mode 100644 sys/linux/dev_bcache.txt.const

diff --git a/executor/common_linux.h b/executor/common_linux.h
index ef97356..494e9ef 100644
--- a/executor/common_linux.h
+++ b/executor/common_linux.h
@@ -2721,6 +2721,113 @@ static long syz_dmz_io(volatile long a0, volatile long a1, volatile long a2)
 }
 #endif
 
+#if SYZ_EXECUTOR || __NR_syz_bcache_setup
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+
+// Build a valid bcache superblock (correct magic + crc64, verified against
+// make-bcache) and register it, so a cache set runs and a backing device
+// attaches. type 0 = cache, type 1 = backing; returns /dev/bcache0 fd for type 1.
+static const unsigned char syz_bcache_magic[16] = {
+    0xc6, 0x85, 0x73, 0xf6, 0x4e, 0x1a, 0x45, 0xca,
+    0x82, 0x65, 0xf5, 0x7f, 0x48, 0xba, 0x6d, 0x81};
+static const unsigned char syz_bcache_set_uuid[16] = {
+    0x53, 0x59, 0x5a, 0x62, 0x63, 0x61, 0x63, 0x68,
+    0x65, 0x53, 0x45, 0x54, 0x30, 0x30, 0x30, 0x31};
+
+static uint64 syz_bch_crc64(const unsigned char* p, unsigned len)
+{
+	uint64 crc = ~(uint64)0;
+	unsigned i;
+	int b;
+	for (i = 0; i < len; i++) {
+		crc ^= (uint64)p[i] << 56;
+		for (b = 0; b < 8; b++)
+			crc = (crc & ((uint64)1 << 63)) ? ((crc << 1) ^ 0x42F0E1EBA9EA3693ULL) : (crc << 1);
+	}
+	return crc ^ ~(uint64)0;
+}
+
+static void syz_bcache_p64(unsigned char* p, uint64 v)
+{
+	int i;
+	for (i = 0; i < 8; i++)
+		p[i] = (v >> (8 * i)) & 0xff;
+}
+
+static void syz_bcache_p16(unsigned char* p, uint16 v)
+{
+	p[0] = v & 0xff;
+	p[1] = (v >> 8) & 0xff;
+}
+
+static long syz_bcache_setup(volatile long a0, volatile long a1, volatile long a2, volatile long a3)
+{
+	unsigned dev = (unsigned)a0 & 7;
+	int type = (int)a1 & 1;
+	uint64 mode = (uint64)a2 & 7;
+	char node[32];
+	unsigned char sb[4096];
+	long long size;
+	uint64 bucket = 1024, nbuckets;
+	int fd, rfd;
+
+	snprintf(node, sizeof(node), "/dev/ram%u", dev);
+	fd = open(node, O_RDWR);
+	if (fd == -1)
+		return -1;
+	size = lseek(fd, 0, SEEK_END);
+	if (size <= 4096 * 2) {
+		close(fd);
+		return -1;
+	}
+	nbuckets = (uint64)(size >> 9) / bucket;
+
+	memset(sb, 0, sizeof(sb));
+	syz_bcache_p64(sb + 8, 8);
+	memcpy(sb + 24, syz_bcache_magic, 16);
+	sb[40] = 'S';
+	sb[41] = 'Z';
+	sb[42] = type ? 'B' : 'C';
+	sb[43] = (unsigned char)dev;
+	memcpy(sb + 56, syz_bcache_set_uuid, 16);
+	if (type == 0) {
+		syz_bcache_p64(sb + 16, 0);
+		syz_bcache_p64(sb + 184, nbuckets);
+		syz_bcache_p16(sb + 192, 8);
+		syz_bcache_p16(sb + 194, (uint16)bucket);
+		syz_bcache_p16(sb + 196, 1);
+		syz_bcache_p16(sb + 198, 0);
+		syz_bcache_p16(sb + 204, 1);
+	} else {
+		syz_bcache_p64(sb + 16, 1);
+		syz_bcache_p64(sb + 104, mode);
+		syz_bcache_p16(sb + 192, 8);
+		syz_bcache_p16(sb + 194, (uint16)bucket);
+	}
+	syz_bcache_p64(sb + 0, syz_bch_crc64(sb + 8, 200));
+
+	if (pwrite(fd, sb, sizeof(sb), 4096) != (long)sizeof(sb)) {
+		close(fd);
+		return -1;
+	}
+	close(fd);
+
+	rfd = open("/sys/fs/bcache/register", O_WRONLY);
+	if (rfd == -1)
+		return -1;
+	if (write(rfd, node, strlen(node)) < 0) {
+		// ignore: EEXIST/EINVAL are the interesting error paths in register_bcache
+	}
+	close(rfd);
+
+	if (type == 1)
+		return open("/dev/bcache0", O_RDWR);
+	return 0;
+}
+#endif
+
 #if SYZ_EXECUTOR || __NR_syz_open_dev
 #include <fcntl.h>
 #include <string.h>
