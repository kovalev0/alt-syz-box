+BLKZEROOUT = amd64:4735
+DM_DEV_REMOVE = amd64:3241737476
+DM_DEV_STATUS = amd64:3241737479
+DM_DEV_SUSPEND = amd64:3241737478
+DM_DEV_WAIT = amd64:3241737480
+DM_MAX_TYPE_NAME = amd64:16
+DM_NAME_LEN = amd64:128
+DM_TABLE_LOAD = amd64:3241737481
+DM_TABLE_STATUS = amd64:3241737484
+DM_TARGET_MSG = amd64:3241737486
+DM_UUID_LEN = amd64:129
+__NR_fsync = amd64:74
