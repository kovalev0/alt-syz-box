{
    "target": "linux/amd64",
    "http": "0.0.0.0:${DEFAULT_SYZ_HTTP_INTERNAL_PORT}",
    "workdir": "${SYZKALLER_WORKDIR}",
    "kernel_obj": "${KERNEL_BUILD_DIR}",
    "kernel_src": "${KERNEL_DIR}",
    "image": "${IMAGE_PATH}",
    "sshkey": "${SSH_KEY_PATH}",
    "ssh_user": "root",
    "syzkaller": "${SYZKALLER_DIR}",
    "procs": 8,
    "fuzzing_vms": 3,
    "type": "qemu",
    "sandbox": "none",
    "cover": true,
    "execprog_bin_on_target": "/bin/linux_amd64/syz-execprog",
    "executor_bin_on_target": "/bin/linux_amd64/syz-executor",
    "vm": {
        "qemu": "${QEMU_BUILD_DIR}/usr/bin/qemu-system-x86_64",
        "count": 4,
        "qemu_args": "-enable-kvm",
        "kernel": "${KERNEL_BZIMAGE}",
        "cpu": 4,
        "cmdline": "root=/dev/sda3",
        "mem": 4096
    },
    "enable_syscalls": [
        "socket",
        "socketpair",
        "bind",
        "connect",
        "accept",
        "accept4",
        "listen",
        "getsockname",
        "getpeername",
        "shutdown",
        "sendto",
        "recvfrom",
        "sendmsg",
        "recvmsg",
        "sendmmsg",
        "recvmmsg",
        "setsockopt",
        "getsockopt",
        "close",
        "syz_emit_ethernet",
        "syz_extract_tcp_res",
        "syz_init_net_socket",
        "syz_genetlink_get_family_id",
        "ioctl${DOL_SIGN}sock*",
        "ioctl${DOL_SIGN}SIOC*",
        "ioctl${DOL_SIGN}TUN*",
        "ioctl${DOL_SIGN}ifreq*",
        "openat${DOL_SIGN}xt_*",
        "write${DOL_SIGN}xt_*",
        "read${DOL_SIGN}xt_*",
        "lseek${DOL_SIGN}xt_*"
    ],
    "cover_filter": {
        "files": [
            "^net/netfilter/ipt-so/",
            "^net/netfilter/xtables-addons/",
            "^net/netfilter/",
            "^net/ipv4/netfilter/",
            "^net/ipv6/netfilter/"
        ]
    }
}
