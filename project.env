# --- Project-wide Default Settings ---
# Source this file in scripts to get default values.

# Default names for Docker image and container
export DEFAULT_IMAGE_NAME="alt-syz-box:latest"
export DEFAULT_CONTAINER_NAME="alt-syz-box-container"

# Default ports
# WEB_PORT is for the syzkaller web interface (host:container)
# VM_SSH_PORT is for connecting to the debug VM (host:container)
# SYZ_HTTP_INTERNAL_PORT is the port used by syzkaller inside the container.
export DEFAULT_WEB_PORT="11000"
export DEFAULT_VM_SSH_PORT="22000"
export DEFAULT_SYZ_HTTP_INTERNAL_PORT="56741"
